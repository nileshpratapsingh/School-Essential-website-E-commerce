<main>
    <section id="school-uniforms">
        <h2>Select School Uniform</h2>

        <select id="gender-select">
            <option value="">-- Select Gender --</option>
            <option value="Boy">Boy</option>
            <option value="Girl">Girl</option>
        </select>

        <select id="uniform-select">
            <option value="">-- Select Uniform Type --</option>
            <option value="Summer">Summer Uniform</option>
            <option value="Winter">Winter Uniform</option>
        </select>

        <!-- Summer Uniform Section -->
        <div id="summer-uniform" class="uniform-section" style="display: none;">
            <h3 id="summer-title"></h3>
            <div class="uniform-category">
                <h4>Summer Items</h4>
                <div class="uniform-item">
                    <label>
                        <p>Half Shirt:</p><img src="../../Images/halfShirt.png" alt="Half Shirt">
                    </label>
                    <select>
                        <option>S</option>
                        <option>M</option>
                        <option>L</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
                <div class="uniform-item">
                    <label>
                        <p>Full Pant:</p><img src="../../Images/fullPant.png" alt="Half Shirt">
                    </label>
                    <select>
                        <option>28</option>
                        <option>30</option>
                        <option>32</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
            </div>

            <div class="uniform-category">
                <h4>Sports Uniform</h4>
                <div class="uniform-item">
                    <label>T-Shirt:<img src="../../Images/SchoolSportsTshirt.png" alt="Half Shirt"></label>
                    <select>
                        <option>S</option>
                        <option>M</option>
                        <option>L</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
                <div class="uniform-item">
                    <label>White Pant:<img src="../../Images/whitePant.png" alt="Half Shirt"></label>
                    <select>
                        <option>28</option>
                        <option>30</option>
                        <option>32</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
                <div class="uniform-item">
                    <label>White Shoes:<img src="../../Images/WhiteSchoolShoes.png" alt="Half Shirt"></label>
                    <select>
                        <option>5</option>
                        <option>6</option>
                        <option>7</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
            </div>
        </div>

        <!-- Winter Uniform Section -->
        <div id="winter-uniform" class="uniform-section" style="display: none;">
            <h3 id="winter-title"></h3>
            <div class="uniform-category">
                <h4>Winter Items</h4>
                <div class="uniform-item">
                    <label>Full Shirt:</label>
                    <select>
                        <option>S</option>
                        <option>M</option>
                        <option>L</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
                <div class="uniform-item">
                    <label>Blazer:</label>
                    <select>
                        <option>28</option>
                        <option>30</option>
                        <option>32</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
            </div>

            <div class="uniform-category">
                <h4>Sports Uniform</h4>
                <div class="uniform-item">
                    <label>T-Shirt:</label>
                    <select>
                        <option>S</option>
                        <option>M</option>
                        <option>L</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
                <div class="uniform-item">
                    <label>White Pant:</label>
                    <select>
                        <option>28</option>
                        <option>30</option>
                        <option>32</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
                <div class="uniform-item">
                    <label>White Shoes:</label>
                    <select>
                        <option>5</option>
                        <option>6</option>
                        <option>7</option>
                    </select>
                    <input type="number" placeholder="Qty" min="0" />
                </div>
            </div>
        </div>

        <div id="add-to-cart-container" style="text-align: center; margin-top: 2rem; display: none;">
            <button id="add-to-cart-btn">
                Add to Cart
            </button>
            <button id="reset-btn">
                Reset Quantities
            </button>

        </div>


    </section>
</main>