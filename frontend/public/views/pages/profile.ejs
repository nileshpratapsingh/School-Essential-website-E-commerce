<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

    <body>
        <%- include('../partials/header') %>
            <%- include('../partials/sidebar') %>
                <main class="profile-container">
                    <!-- Profile Header -->
                    <div class="profile-header">
                        <% if (user.profileImage) { %>
                            <img src="<%= user.profileImage || null%>" alt="Profile Picture" class="profile-img">
                            <% } else { %>
                                <ion-icon name="person-circle-outline" class="profile-placeholder"></ion-icon>
                                <% } %>
                                    <h2>
                                        <%= user.firstName %>
                                            <%=user.middleName ||null %>
                                                <%= user.lastName %>
                                    </h2>
                                    <p class="role">
                                        <%= user.role %>
                                    </p>
                    </div>

                    <!-- Profile Info -->
                    <div class="profile-info">
                        <p><strong>ID:</strong>
                            <%= user._id %>
                        </p>
                        <p><strong>Email:</strong>
                            <%= user.email %>
                        </p>
                        <p><strong>Alternate Email:</strong>
                            <%= user.alternateEmail %>
                        </p>
                        <p><strong>Phone:</strong>
                            <%= user.phoneNumber %>
                        </p>
                        <p><strong>Date of Birth:</strong>
                            <%= new Date(user.dateOfBirth).toDateString("en-GB") %>
                        </p>
                        <p><strong>Gender:</strong>
                            <%= user.gender %>
                        </p>
                        <p>
                            <strong>Address:</strong>
                            <%= user.address ? `${user.address.street}, ${user.address.city}, ${user.address.state} -
                                ${user.address.zip}` : "Not Provided" %>
                        </p>
                        <p><strong>Created At:</strong>
                            <%= new Date(user.createdAt).toLocaleString("en-GB") %>
                        </p>
                    </div>

                    <!-- Edit Button -->
                    <div class="profile-actions">
                        <a href="/edit-profile/<%= user._id %>" class="edit-btn">
                            <ion-icon name="create-outline"></ion-icon> Edit Info
                        </a>
                    </div>
                </main>
                <%- include('../partials/footer') %>
    </body>

</html>