<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>404 Not Found</title>
  <style>
    body {
      background: #0f172a;
      color: #f8fafc;
      font-family: 'Segoe UI', sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
      text-align: center;
    }

    h1 {
      font-size: 6rem;
      margin: 0;
      color: #f87171;
    }

    p {
      font-size: 1.5rem;
      margin: 1rem 0;
    }

    a {
      margin-top: 2rem;
      padding: 0.75rem 1.5rem;
      background: #f87171;
      color: #fff;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.3s ease;
    }

    a:hover {
      background: #ef4444;
    }
  </style>
</head>
<body>
  <h1>404</h1>
  <p>Oops! The page you're looking for doesn't exist.</p>
<a href="" onclick="history.back()">Go back home</a>
</body>
</html>
