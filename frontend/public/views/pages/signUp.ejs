<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

    <body>
        <%- include('../partials/header') %>
            <%- include('../partials/sidebar') %>

                <main>
                    <section class="formbody">
                        <form action="/signup" method="POST" enctype="multipart/form-data" id="signup-form">
                            <div class="input-container">

                                <label for="firstName">First Name</label>
                                <input type="text" name="firstName" id="firstName" required />
                                <span class="error" id="firstNameError"></span>

                                <label for="middleName">Middle Name</label>
                                <input type="text" name="middleName" id="middleName" />

                                <label for="lastName">Last Name</label>
                                <input type="text" name="lastName" id="lastName" required />

                                <label for="image">Profile Image</label>
                                <input type="file" name="profileImage" id="fileInput" accept="image/*" />
                                <img id="preview" src="" alt="Image Preview" style="display:none; max-width:300px;" />
                                <br>
                                <label for="phoneNumber">Phone No.</label>
                                <input type="tel" name="phoneNumber" id="phoneNumber" />

                                <label for="alternatePhoneNumber">Alternate Phone No.</label>
                                <input type="tel" name="alternatePhoneNumber" id="alternatePhoneNumber" />

                                <label for="email">Email</label>
                                <input type="email" name="email" id="email" />
                                <span class="error" id="emailError"></span>

                                <label for="alternateEmail">Alternate Email</label>
                                <input type="email" name="alternateEmail" id="alternateEmail" />

                                <label for="dateOfBirth">Date of Birth</label>
                                <input type="date" name="dateOfBirth" id="dateOfBirth" required />

                                <label>Gender</label>
                                <div class="radio-group">
                                    <label><input type="radio" name="gender" value="Male" /> Male</label>
                                    <label><input type="radio" name="gender" value="Female" /> Female</label>
                                    <label><input type="radio" name="gender" value="Others" /> Others</label>
                                </div>

                                <label for="address">Address</label>
                                <address>
                                    <input type="text" id="street" placeholder="Street Address" name="address.street"
                                        required> <span class="error" id="addressError"></span>
                                    <select id="state" name="address.state" required>
                                        <option value="">Select State</option>
                                    </select> <span class="error" id="stateError"></span> <select id="city"
                                        name="address.city" required>
                                        <option value="">Select City</option>
                                    </select>
                                    <span class="error" id="cityError"></span>
                                    <input type="text" id="zip" placeholder="ZIP Code" name="address.zip" required>
                                    <span class="error" id="zipError"></span>
                                </address>

                                <label for="password">Password</label>
                                <input type="password" name="password" id="confirmPassword" required />

                                <label for="password">Confirm Password</label>
                                <input type="password" name="confirmPassword" id="confirmPassword" required />
                            </div>

                            <div class="signup-button-container">
                                <button type="submit" class="signup-form-button">Create Account</button>
                                <button type="reset" id="signup-reset">Reset</button>

                                <p>Already have an account?</p>
                                <a href="/login" class="signup-form-button"><button class="signup-form-button">Login</button>

                                </a>
                            </div>
                        </form>
                    </section>
                </main>

                <%- include('../partials/loading-screen') %>
                    <%- include('../partials/footer') %>
    </body>

</html>
